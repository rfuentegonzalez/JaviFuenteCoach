# Página de inicio
DirectoryIndex index.php

# Bloquea el acceso directo a la carpeta de datos y a la configuración
RedirectMatch 403 ^/includes/
<Files "config.php">
    Require all denied
</Files>

# Cabeceras de seguridad básicas
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Caché larga para imágenes, fuentes, CSS y JS (los enlaces llevan ?v= para refrescar)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# Forzar HTTPS (activa estas líneas cuando el dominio tenga certificado SSL)
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Registro interno de la publicación automática (no debe verse desde fuera)
<Files ".ftp-deploy-sync-state.json">
    Require all denied
</Files>
